{
  "id": "com.pojtinger.felicitas.Sessions",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "sessions",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=dri",
    "--socket=pulseaudio"
  ],
  "modules": [
    {
      "name": "ruby",
      "buildsystem": "autotools",
      "config-opts": [
        "--prefix=/app",
        "--disable-install-doc",
        "--enable-shared"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://cache.ruby-lang.org/pub/ruby/3.4/ruby-3.4.2.tar.gz",
          "sha256": "41328ac21f2bfdd7de6b3565ef4f0dd7543354d37e96f157a1552a6bd0eb364b"
        }
      ]
    },
    {
      "name": "sessions",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p nix/vendor/cache",
        "cp vendor-gems/*.gem nix/vendor/cache/",
        "bash -c 'export BUNDLE_GEMFILE=\"$(pwd)/nix/Gemfile\" && bundle config set --local path \"/app/lib/sessions/vendor/bundle\" && bundle config set --local cache_path \"$(pwd)/nix/vendor/cache\" && bundle config set --local deployment true && bundle install --local'",
        "mkdir -p /app/share/sessions",
        "cp -r lib /app/share/sessions/",
        "cp -r data /app/share/sessions/",
        "cp -r po /app/share/sessions/",
        "install -Dm755 exe/sessions /app/share/sessions/exe/sessions",
        "mkdir -p /app/share/glib-2.0/schemas",
        "cp data/${FLATPAK_ID}.gschema.xml /app/share/glib-2.0/schemas/",
        "glib-compile-schemas /app/share/glib-2.0/schemas",
        "desktop-file-install --dir=/app/share/applications data/${FLATPAK_ID}.desktop.in --set-key=Exec --set-value=Exec=sessions || install -Dm644 data/${FLATPAK_ID}.desktop.in /app/share/applications/${FLATPAK_ID}.desktop",
        "install -D -m 0644 data/${FLATPAK_ID}.metainfo.xml.in /app/share/metainfo/${FLATPAK_ID}.metainfo.xml",
        "install -D -m 0644 data/${FLATPAK_ID}.svg /app/share/icons/hicolor/scalable/apps/${FLATPAK_ID}.svg",
        "install -D -m 0644 data/${FLATPAK_ID}-symbolic.svg /app/share/icons/hicolor/symbolic/apps/${FLATPAK_ID}-symbolic.svg",
        "mkdir -p /app/share/locale",
        "bash -c 'while read -r lang; do [ -f \"po/$lang.po\" ] || continue; mkdir -p \"/app/share/locale/$lang/LC_MESSAGES\"; msgfmt -c --check-format -o \"/app/share/locale/$lang/LC_MESSAGES/sessions.mo\" \"po/$lang.po\"; done < po/LINGUAS'",
        "install -Dm755 /dev/stdin /app/bin/sessions <<'SESSIONS_WRAPPER'\n#!/bin/sh\nexport SESSIONS_LOCALE_DIR=/app/share/locale\nexport SESSIONS_SCHEMA_DIR=/app/share/glib-2.0/schemas\nexec /app/bin/ruby -I/app/share/sessions/lib -I/app/lib/sessions/vendor/bundle/ruby/*/gems/*/lib /app/share/sessions/exe/sessions \"$@\"\nSESSIONS_WRAPPER"
      ],
